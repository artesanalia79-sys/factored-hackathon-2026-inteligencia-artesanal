{
  "$defs": {
    "ActionType": {
      "enum": [
        "create_dispute",
        "block_card",
        "create_handoff"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "DecisionType": {
      "enum": [
        "proceed",
        "clarify",
        "abstain",
        "escalate",
        "ineligible"
      ],
      "title": "DecisionType",
      "type": "string"
    },
    "Language": {
      "enum": [
        "es",
        "pt"
      ],
      "title": "Language",
      "type": "string"
    },
    "PolicyDecision": {
      "additionalProperties": false,
      "description": "Deterministic decision of the policy engine for one request.\n\n``target_transaction_id`` is the transaction this decision was evaluated for, when it was\nevaluated against one (``None`` for a baseline/ad hoc decision with no bound target). A write\ntool that allows ``create_dispute`` must refuse a call whose ``args.transaction_id`` differs\nfrom it: otherwise a decision computed for transaction A would authorize, and stamp its SLA\nand rule ids onto, a dispute on transaction B (T8 PR #43 review; T9 PR #44 review).",
      "properties": {
        "allowed_actions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ActionType"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "decision": {
          "$ref": "#/$defs/DecisionType"
        },
        "escalation_triggers": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Escalation Triggers",
          "type": "array"
        },
        "explanation_keys": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Explanation Keys",
          "type": "array"
        },
        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "required_slots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Required Slots",
          "type": "array"
        },
        "requires_confirmation": {
          "default": false,
          "title": "Requires Confirmation",
          "type": "boolean"
        },
        "rule_ids": {
          "default": [],
          "items": {
            "type": "string"
          },
          "title": "Rule Ids",
          "type": "array"
        },
        "sla_due_date": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sla Due Date"
        },
        "target_transaction_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Transaction Id"
        }
      },
      "required": [
        "decision",
        "policy_version"
      ],
      "title": "PolicyDecision",
      "type": "object"
    },
    "Session": {
      "additionalProperties": false,
      "description": "Server-side authenticated session.\n\n``customer_id`` never leaves the server: it is not sent to the LLM, not accepted from the\nclient and not present in any tool argument model.",
      "properties": {
        "customer_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Customer Id",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        },
        "issued_at": {
          "format": "date-time",
          "title": "Issued At",
          "type": "string"
        },
        "language": {
          "anyOf": [
            {
              "$ref": "#/$defs/Language"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "session_id": {
          "maxLength": 64,
          "minLength": 1,
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "customer_id",
        "issued_at",
        "expires_at"
      ],
      "title": "Session",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Server-side context of a tool call. Built by the orchestrator, never by the model.\n\n``policy`` is the decision the write was allowed under. ``create_dispute`` and ``block_card``\nrefuse an action the decision does not allow, and the dispute is stamped with its version,\nrule ids and SLA due date.",
  "properties": {
    "confirmation_token_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confirmation Token Id"
    },
    "now": {
      "format": "date-time",
      "title": "Now",
      "type": "string"
    },
    "policy": {
      "anyOf": [
        {
          "$ref": "#/$defs/PolicyDecision"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "session": {
      "$ref": "#/$defs/Session"
    },
    "trace_id": {
      "maxLength": 64,
      "minLength": 1,
      "title": "Trace Id",
      "type": "string"
    }
  },
  "required": [
    "session",
    "trace_id",
    "now"
  ],
  "title": "ToolContext",
  "type": "object"
}
