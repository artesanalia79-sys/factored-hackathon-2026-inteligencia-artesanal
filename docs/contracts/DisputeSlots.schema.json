{
  "additionalProperties": false,
  "description": "Facts the customer mentioned. Unverified until matched against a real transaction.",
  "properties": {
    "amount": {
      "anyOf": [
        {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*(?:\\d{0,13}|(?=[\\d.]{1,16}0*$)\\d{0,13}\\.\\d{0,2}0*$)",
              "type": "string"
            }
          ],
          "ge": 0
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Amount"
    },
    "card_block_requested": {
      "default": false,
      "title": "Card Block Requested",
      "type": "boolean"
    },
    "card_last4": {
      "anyOf": [
        {
          "pattern": "^\\d{4}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Card Last4"
    },
    "currency": {
      "anyOf": [
        {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Currency"
    },
    "date_text": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Date Text"
    },
    "merchant_query": {
      "anyOf": [
        {
          "maxLength": 100,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Merchant Query"
    },
    "transaction_ref": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Transaction Ref"
    }
  },
  "title": "DisputeSlots",
  "type": "object"
}
