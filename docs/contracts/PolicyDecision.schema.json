{
  "$defs": {
    "ActionType": {
      "enum": [
        "create_dispute",
        "block_card",
        "create_handoff"
      ],
      "title": "ActionType",
      "type": "string"
    },
    "DecisionType": {
      "enum": [
        "proceed",
        "clarify",
        "abstain",
        "escalate",
        "ineligible"
      ],
      "title": "DecisionType",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Deterministic decision of the policy engine for one request.\n\n``target_transaction_id`` is the transaction this decision was evaluated for, when it was\nevaluated against one (``None`` for a baseline/ad hoc decision with no bound target). A write\ntool that allows ``create_dispute`` must refuse a call whose ``args.transaction_id`` differs\nfrom it: otherwise a decision computed for transaction A would authorize, and stamp its SLA\nand rule ids onto, a dispute on transaction B (T8 PR #43 review; T9 PR #44 review).\n``target_product_id`` is the card of that transaction, the only card ``block_card`` may block\nunder this decision (same reasoning, for the block).",
  "properties": {
    "allowed_actions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ActionType"
      },
      "title": "Allowed Actions",
      "type": "array"
    },
    "decision": {
      "$ref": "#/$defs/DecisionType"
    },
    "escalation_triggers": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Escalation Triggers",
      "type": "array"
    },
    "explanation_keys": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Explanation Keys",
      "type": "array"
    },
    "policy_version": {
      "title": "Policy Version",
      "type": "string"
    },
    "required_slots": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Required Slots",
      "type": "array"
    },
    "requires_confirmation": {
      "default": false,
      "title": "Requires Confirmation",
      "type": "boolean"
    },
    "rule_ids": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Rule Ids",
      "type": "array"
    },
    "sla_due_date": {
      "anyOf": [
        {
          "format": "date",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sla Due Date"
    },
    "target_product_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Product Id"
    },
    "target_transaction_id": {
      "anyOf": [
        {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Target Transaction Id"
    }
  },
  "required": [
    "decision",
    "policy_version"
  ],
  "title": "PolicyDecision",
  "type": "object"
}
