      "dot": "emerald",
      "title": "Control before action",
      "items": [
        "The attack gate runs before interpretation.",
        "Dispute and block require explicit confirmation",
        "and a single-use token bound to exact arguments."
      ]
    },
    {
      "dot": "cyan",
      "title": "Verified outcomes",
      "items": [
        "Templates claim only verified actions.",
        "Uncertain cases clarify, abstain or hand off.",
        "The bank console reads handoffs and traces."
      ]
    },
