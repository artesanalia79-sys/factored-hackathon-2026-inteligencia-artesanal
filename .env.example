# Copy to .env (gitignored) with `uv run poe init-env`, then fill in values locally.
# NEVER commit real values. AWS access keys do NOT go here: run
#   aws configure --profile factored
# so the keys live only in your local AWS CLI profile (~/.aws/credentials).

# --- Organizer dataset (read-only S3) ---
AWS_PROFILE=factored
AWS_DEFAULT_REGION=
S3_BUCKET=
# Scopes every S3 listing to the active dataset root. The bucket has also held sibling
# snapshot/backup folders at its root (e.g. a dated backup); leave this as-is unless the
# organizers change the bucket layout.
INGEST_SOURCE_PREFIX=data/

# --- LLM provider ---
# Leave empty to run everything with the deterministic StubProvider (0 USD).
OPENAI_API_KEY=
LLM_PROVIDER=stub
LLM_MODEL=gpt-6-luna

# Any OpenAI-compatible chat endpoint (OpenRouter, Groq, ...), used by
# bankagent.interpret.compat_provider.from_env. All three are required to use it. The key is NOT
# OPENAI_API_KEY on purpose: that key must never be sent to a third-party endpoint. The URL must
# be https (http only for localhost).
LLM_BASE_URL=
LLM_API_KEY=
# json_schema (strict; needs vendor support) or json_object (schema in the prompt).
LLM_RESPONSE_MODE=json_schema
# Requests per UTC day. Free models are limited by requests, not dollars, so set it below the
# vendor's daily cap; past it the provider raises LLMUnavailable and the caller falls back.
LLM_DAILY_CALL_LIMIT=
# Only for a model missing from config/pricing.yaml. Cost is then recorded as 0 ("not priced"),
# which is not evidence of cost per resolution.
LLM_ALLOW_UNPRICED=

# --- Application ---
# Random secret used to sign demo session tokens. Generated by `poe init-env`.
APP_SECRET_KEY=
# synthetic = team-generated fixture personas (public default); curated = organizer-derived serving DB (local only)
# For curated: DATA_MODE=curated and SERVING_DB_PATH=data/serving/bank_curated.duckdb (built by `poe serving-build`)
DATA_MODE=synthetic
# true = return the mock OTP in the login response (demo: there is no SMS channel). Leave it
# unset anywhere real. It is refused unless the data is synthetic (never with DATA_MODE=curated).
AUTH_EXPOSE_MOCK_OTP=true
SERVING_DB_PATH=data/fixtures/bank_fixture.duckdb
OPS_DB_PATH=data/runtime/ops.sqlite

# --- Evaluation ---
# Absolute path OUTSIDE the repository where the sealed held-out set lives. Agents must never read it.
HELDOUT_DIR=
